generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum Role {
  SUPER_ADMIN
  MANAGER
  BARBER
}

model Service {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  durationMin Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  barberServices  BarberService[]
  bookingServices BookingService[]

  @@map("services")
}

model Barber {
  id         String   @id @default(uuid())
  name       String
  roleTitle  String
  bio        String?
  avatarUrl  String?
  phone      String?
  email      String?  @unique
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  barberServices BarberService[]
  workingHours   WorkingHours[]
  breaks         Break[]
  timeOffs       TimeOff[]
  bookings       Booking[]
  reviews        Review[]

  @@map("barbers")
}

model BarberService {
  id        String  @id @default(uuid())
  barberId  String
  serviceId String

  barber  Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([barberId, serviceId])
  @@map("barber_services")
}

model WorkingHours {
  id        String  @id @default(uuid())
  barberId  String
  dayOfWeek Int     // 0 = Sunday, 1 = Monday, ... 6 = Saturday
  startTime String  // e.g. "10:00"
  endTime   String  // e.g. "20:00"
  isOff     Boolean @default(false)

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barberId, dayOfWeek])
  @@map("working_hours")
}

model Break {
  id        String @id @default(uuid())
  barberId  String
  dayOfWeek Int    // 0..6
  startTime String // e.g. "14:00"
  endTime   String // e.g. "15:00"

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@map("breaks")
}

model TimeOff {
  id        String   @id @default(uuid())
  barberId  String
  startDate DateTime
  endDate   DateTime
  reason    String?

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@map("time_off")
}

model Client {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]
  reviews  Review[]

  @@map("clients")
}

model Booking {
  id            String        @id @default(uuid())
  token         String        @unique @default(cuid())
  barberId      String
  clientId      String
  bookingDate   DateTime
  startTime     String        // e.g. "14:00"
  endTime       String        // e.g. "15:15"
  totalPrice    Decimal       @db.Decimal(10, 2)
  totalDuration Int           // in minutes
  status              BookingStatus @default(CONFIRMED)
  clientNotes         String?
  internalNotes       String?
  reminderDaySentAt   DateTime?
  reminder30mSentAt   DateTime?
  reviewRequestedAt   DateTime?
  autoCompletedAt     DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt


  barber          Barber           @relation(fields: [barberId], references: [id])
  client          Client           @relation(fields: [clientId], references: [id])
  bookingServices BookingService[]
  review          Review?

  @@map("bookings")
}

model BookingService {
  id        String  @id @default(uuid())
  bookingId String
  serviceId String
  price     Decimal @db.Decimal(10, 2)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])

  @@map("booking_services")
}

model Review {
  id        String   @id @default(uuid())
  bookingId String   @unique
  barberId  String
  clientId  String
  rating    Int      // 1..5
  comment   String?
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])
  barber  Barber  @relation(fields: [barberId], references: [id])
  client  Client  @relation(fields: [clientId], references: [id])

  @@map("reviews")
}

model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value String

  @@map("settings")
}

model AdminUser {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         Role     @default(MANAGER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_users")
}
