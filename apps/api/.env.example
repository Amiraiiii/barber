# Supabase / PostgreSQL Connection Strings
DATABASE_URL=postgresql://postgres.xxx:xxx@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxx:xxx@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# Supabase API Credentials
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_publishable_xxx

# Telegram Bot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# API Server & CORS
PORT=4000
NODE_ENV=production
ALLOWED_ORIGINS=https://your-barber-web.vercel.app,https://your-barber-miniapp.vercel.app

# Public URL of this API (used for registering Telegram Webhooks)
API_URL=https://your-barber-api.vercel.app

# Secret for Supabase Edge Functions / Cron calls
CRON_SECRET=blackline_cron_secret
